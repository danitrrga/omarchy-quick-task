#!/usr/bin/env python3
"""Launch the Quick Task helper from the plugin folder."""

from pathlib import Path
import sys


# The shell reloads the plugin when its folder changes, and a __pycache__ is a change.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

from quick_task.cli import main


raise SystemExit(main())
