#!/usr/bin/env python3
"""Launch Quick Task from the repository or its user installation."""

from pathlib import Path
import sys


script = Path(__file__).resolve()
repo_source = script.parent.parent / "src"
installed_source = Path.home() / ".local" / "share" / "quick-task"
for source in (repo_source, installed_source):
    if (source / "quick_task").is_dir():
        sys.path.insert(0, str(source))
        break

from quick_task.cli import main


raise SystemExit(main())
